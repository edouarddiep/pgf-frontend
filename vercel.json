{
  "version": 2,
  "buildCommand": "sed -i 's/INVITE_KEY_PLACEHOLDER/'\"$INVITE_KEY\"'/g' src/environments/environment.prod.ts && npm run build",
  "outputDirectory": "dist/pgf-frontend/browser",
  "framework": null,
  "alias": ["gonsethfavre.vercel.app", "pierrette-gonsethfavre.ch", "www.pierrette-gonsethfavre.ch"],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*).(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
